{
  "expo": {
    "name": "ASOOSE RIDER",
    "slug": "asoose-rider-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asoose.rider.app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asoose.rider.app",
      "config": {
        "googleMapsApiKey": "AIzaSyC1QLEDtvDu8r1gLtEec4d28aWP8VozXfA"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "ASOOSE Rider App requires access to your photo library to allow you to upload a profile picture and provide proof of delivery by selecting stored images. For example, you can select a photo of a delivered package as confirmation."
      }
    },
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCor0YAMApwfowNFC-EXSOwrKq0mxdwMP8"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.asoose.rider.app",
      "notification": {
        "icon": "./assets/images/icon.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "blockedPermissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "CALL_PHONE",
        "SEND_SMS"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0A0A0A"
          },
          "backgroundColor": "#F9FAFB",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ASOOSE Rider App needs your location to show your real-time position, match you with nearby orders, and provide accurate navigation. For example, your location is shared with the customer while you are on your way to deliver their order to keep them updated on your arrival.",
          "locationAlwaysPermission": "ASOOSE Rider App requires background location access to track your position and keep you matched with orders even when the app is in the background. This ensures you can receive delivery opportunities while you are on the move."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0EA5E9",
          "mode": "production",
          "sounds": [
            "./assets/sounds/notification_alarm.wav"
          ]
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "@rnmapbox/maps"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d48f46a-1d28-48e3-9a5b-77e6256bdc3b"
      }
    },
    "owner": "iamwyteshadow"
  }
}