{
  "expo": {
    "name": "ASOOSE VENDOR APP",
    "slug": "asoose-vendor-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vendorapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asoose.vendor.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "platforms": ["ios", "android"],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.asoose.vendor.app",
      "permissions": ["INTERNET", "ACCESS_FINE_LOCATION", "POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_CONTACTS",
        "CALL_PHONE",
        "SEND_SMS"
      ]
    },
    "privacy": "https://asoose.com/vendor-privacy-policy",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9FAFB",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ASOOSE Vendor App needs access to your photo library to upload product images, store logos, and business verification documents for your multi-marketplace store."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ASOOSE Vendor App needs your location to help you set your store address. Location is only used when you tap 'Use Current Location' and is not tracked in the background."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0EA5E9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f144011b-bf0a-4ba1-9cdf-b89dd47a1a2b"
      }
    }
  }
}
