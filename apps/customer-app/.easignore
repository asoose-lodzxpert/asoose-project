# EAS Build ignore file — customer-app
# EAS uses .easignore (like .gitignore) to determine what NOT to upload to build servers.
# node_modules are NOT uploaded — EAS installs them fresh on build servers.

node_modules/
.expo/
dist/
web-build/
.DS_Store
*.log
*.local
.env*.local

# Plan / research documents (not needed for building)
PLAN.md
README.md

# Development scripts (not needed for building)
scripts/

# TypeScript build cache
*.tsbuildinfo

# Generated native folders (EAS manages these)
android/
ios/
