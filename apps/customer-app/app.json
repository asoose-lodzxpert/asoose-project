{
  "expo": {
    "name": "ASOOSE",
    "slug": "asoose-customer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "privacyPolicyUrl": "https://asoose.com/privacy-policy",
    "icon": "./assets/images/asoose-icon.png",
    "scheme": "asoose-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/ios-light.png",
      "iconDark": "./assets/images/ios-dark.png",
      "iconTinted": "./assets/images/ios-tinted.png",
      "splash": {
        "image": "./assets/images/splash-icon-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/images/splash-icon-dark.png",
          "backgroundColor": "#000000"
        }
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "ASOOSE uses Face ID to securely authenticate you when logging into your account.",
        "NSBiometricUsageDescription": "ASOOSE uses biometric authentication so you can log in quickly and securely.",
        "NSUserAuthenticationUsageDescription": "Authentication is required to access your ASOOSE account and protect your personal data.",
        "NSCameraUsageDescription": "ASOOSE needs camera access to let you take or upload a profile photo.",
        "NSLocationWhenInUseUsageDescription": "ASOOSE uses your location to show nearby stores, calculate accurate delivery fees, track your orders in real time, and let you set pickup and drop-off points for rides.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.asoose.app",
      "config": {
        "googleMapsApiKey": "AIzaSyC1QLEDtvDu8r1gLtEec4d28aWP8VozXfA"
      },
      "usesAppleSignIn": true
    },
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCor0YAMApwfowNFC-EXSOwrKq0mxdwMP8"
        }
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.asoose.app",
      "notification": {
        "icon": "./assets/images/asoose-icon.png"
      },
      "blockedPermissions": [
        "RECORD_AUDIO",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_CONTACTS",
        "CALL_PHONE",
        "SEND_SMS"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ASOOSE needs access to your photo library to upload profile pictures and share images."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ASOOSE needs your location to show nearby stores, calculate delivery fees, and provide accurate delivery tracking."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/asoose-icon.png",
          "color": "#0EA5E9",
          "mode": "production",
          "sounds": [
            "./assets/sounds/notification_alarm.wav"
          ],
          "NSUserNotificationsUsageDescription": "ASOOSE sends you notifications for order updates, delivery tracking, ride confirmations, and important account activity."
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.520199690549-s90js4cdaf1hhmbestsmddtc5lf3nnse"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "efdbbc55-7bbe-4db6-9a9d-d7116d8d3d8d"
      }
    },
    "owner": "iamwyteshadow"
  }
}