{
  "expo": {
    "name": "ASOOSE",
    "slug": "asoose-customer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "privacyPolicyUrl": "https://asoose.com/privacy-policy",
    "icon": "./assets/images/asoose icon.png",
    "scheme": "asoose-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/ios-light.png",
      "iconDark": "./assets/images/ios-dark.png",
      "iconTinted": "./assets/images/ios-tinted.png",
      "splash": {
        "image": "./assets/images/splash-icon-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/images/splash-icon-dark.png",
          "backgroundColor": "#000000"
        }
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "This app uses Face ID to securely authenticate you.",
        "NSBiometricUsageDescription": "Biometric authentication is used for secure login.",
        "NSUserAuthenticationUsageDescription": "Authentication is required to access your account.",
        "NSCameraUsageDescription": "This app requires camera access to take photos and scan documents.",
        "NSPhotoLibraryUsageDescription": "This app requires access to your photo library to select images.",
        "NSLocationWhenInUseUsageDescription": "Location is used to provide location-based services.",
        "NSUserNotificationUsageDescription": "Notifications are used to keep you updated about your account and activity."
      },
      "bundleIdentifier": "com.asoose.app",
      "usesAppleSignIn": true
    },
    "platforms": ["ios", "android"],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.asoose.app",
      "versionCode": 1,
      "notification": {
        "icon": "./assets/images/asoose icon.png"
      },
      "blockedPermissions": [
        "RECORD_AUDIO",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_CONTACTS",
        "CALL_PHONE",
        "SEND_SMS"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ASOOSE needs access to your photo library to upload profile pictures and share images."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ASOOSE needs your location to show nearby stores, calculate delivery fees, and provide accurate delivery tracking."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/asoose icon.png",
          "color": "#0EA5E9",
          "mode": "production"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "efdbbc55-7bbe-4db6-9a9d-d7116d8d3d8d"
      }
    }
  }
}
