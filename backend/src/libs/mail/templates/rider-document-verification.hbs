<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Document Verification Result</title>
  </head>
  <body
    style='margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f4f4;'
  >
    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background-color: #f4f4f4; padding: 20px;'
    >
      <tr>
        <td align='center'>
          <table
            width='600'
            cellpadding='0'
            cellspacing='0'
            style='background-color: #ffffff; border-radius: 8px; overflow: hidden;'
          >
            <!-- Header -->
            <tr>
              <td
                style='background-color: #E5A503; padding: 30px; text-align: center;'
              >
                <h1 style='color: #ffffff; margin: 0; font-size: 24px;'>Document
                  Verification Update</h1>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style='padding: 40px 30px;'>
                <p
                  style='color: #333333; font-size: 16px; line-height: 1.6; margin-bottom: 20px;'
                >
                  Dear
                  {{riderName}},
                </p>

                <p
                  style='color: #333333; font-size: 16px; line-height: 1.6; margin-bottom: 20px;'
                >
                  Your
                  {{documentType}}
                  document has been reviewed by our verification team.
                </p>

                <div
                  style='background-color: #f9f9f9; padding: 20px; border-left: 4px solid #E5A503; margin-bottom: 20px;'
                >
                  <p
                    style='color: #333333; font-size: 15px; margin: 0 0 10px 0;'
                  >
                    <strong>Document Type:</strong>
                    {{documentType}}
                  </p>
                  <p style='color: #333333; font-size: 15px; margin: 0;'>
                    <strong>Status:</strong>
                    {{#if isVerified}}
                      <span style='color: #2e7d32;'>Verified</span>
                    {{else if isRejected}}
                      <span style='color: #d32f2f;'>Rejected</span>
                    {{else}}
                      <span style='color: #f57c00;'>Pending</span>
                    {{/if}}
                  </p>
                </div>

                {{#if isRejected}}
                  <p
                    style='color: #666666; font-size: 14px; line-height: 1.6; margin-bottom: 20px;'
                  >
                    <strong>Reason for Rejection:</strong>
                  </p>
                  <p
                    style='color: #333333; font-size: 15px; line-height: 1.6; margin-bottom: 20px;'
                  >
                    {{rejectionReason}}
                  </p>

                  <p
                    style='color: #666666; font-size: 14px; line-height: 1.6; margin-bottom: 20px;'
                  >
                    Please resubmit your document addressing the concerns
                    mentioned above. Clear, legible documents will help expedite
                    the verification process.
                  </p>
                {{/if}}

                {{#if isVerified}}
                  <p
                    style='color: #2e7d32; font-size: 14px; line-height: 1.6; margin-bottom: 20px;'
                  >
                    Congratulations! Your document has been verified. You are
                    now fully verified on our platform.
                  </p>
                {{/if}}

                <p
                  style='color: #333333; font-size: 16px; line-height: 1.6; margin-bottom: 30px;'
                >
                  Best regards,
                  <br />
                  The Asoose Support Team
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style='background-color: #f4f4f4; padding: 20px; text-align: center; border-top: 1px solid #e0e0e0;'
              >
                <p style='color: #999999; font-size: 12px; margin: 0;'>
                  This is an automated notification. Please do not reply to this
                  email.
                </p>
                <p style='color: #999999; font-size: 12px; margin: 5px 0 0 0;'>
                  Asoose Platform
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>