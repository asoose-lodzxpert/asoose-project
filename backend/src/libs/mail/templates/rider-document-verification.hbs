<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Document Verification Update</title>
</head>
<body style="margin:0;padding:0;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;">
    <tr>
      <td style="padding:20px 24px 16px 24px;">
        <span style="font-size:15px;font-weight:700;color:#000000;letter-spacing:-0.2px;">Asoose</span>
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="background-color:#e5e7eb;font-size:0;line-height:0;">&nbsp;</td></tr></table>
      </td>
    </tr>
    <tr>
      <td style="padding:20px 24px 16px 24px;">
        <p style="margin:0;font-size:15px;font-weight:700;color:#111111;">Document Verification Update</p>
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="background-color:#e5e7eb;font-size:0;line-height:0;">&nbsp;</td></tr></table>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px;">
        <p style="margin:0;font-size:14px;color:#374151;line-height:1.6;">Dear {{riderName}}, your document has been reviewed by our verification team.</p>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px 0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;">Document Type</td>
          <td style="padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;">{{documentType}}</td>
        </tr>
        <tr>
          <td style="padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;">Status</td>
          <td style="padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;">{{#if isVerified}}Verified{{else if isRejected}}Rejected{{else}}Pending{{/if}}</td>
        </tr>
        </table>
      </td>
    </tr>
    <tr>
      <td style="padding:0 24px 16px 24px;">
        {{#if isRejected}}
    <tr>
      <td style="padding:16px 24px 0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;">Rejection Reason</td>
          <td style="padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;">{{rejectionReason}}</td>
        </tr>
        </table>
      </td>
    </tr>
        <p style="margin:12px 0 0 0;font-size:14px;color:#374151;line-height:1.6;">Please resubmit your document addressing the concerns above. Ensure the document is legible and complete.</p>
        {{/if}}
        {{#if isVerified}}
        <p style="margin:0;font-size:14px;color:#374151;line-height:1.6;">Your document has been verified. Your profile is now fully verified on the platform.</p>
        {{/if}}
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="background-color:#e5e7eb;font-size:0;line-height:0;">&nbsp;</td></tr></table>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px;">
        <p style="margin:0;font-size:12px;color:#9ca3af;line-height:1.5;">This is an automated notification. Do not reply to this email. &mdash; Asoose Platform</p>
      </td>
    </tr>
  </table>
</body>
</html>