<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vendor Account Created</title>
</head>
<body style="margin:0;padding:0;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;">
    <tr>
      <td style="padding:20px 24px 16px 24px;">
        <span style="font-size:15px;font-weight:700;color:#000000;letter-spacing:-0.2px;">Asoose</span>
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="background-color:#e5e7eb;font-size:0;line-height:0;">&nbsp;</td></tr></table>
      </td>
    </tr>
    <tr>
      <td style="padding:20px 24px 16px 24px;">
        <p style="margin:0;font-size:15px;font-weight:700;color:#111111;">Your Vendor Account is Ready</p>
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="background-color:#e5e7eb;font-size:0;line-height:0;">&nbsp;</td></tr></table>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px;">
        <p style="margin:0;font-size:14px;color:#374151;line-height:1.6;">Hi {{vendorName}},</p>
      </td>
    </tr>
    <tr>
      <td style="padding:0 24px 16px 24px;">
        <p style="margin:0;font-size:14px;color:#374151;line-height:1.6;">
          Your vendor store <strong>{{storeName}}</strong> has been set up by the Asoose team and is now <strong style="color:#16a34a;">ACTIVE &amp; VERIFIED</strong> — you can start selling immediately.
        </p>
      </td>
    </tr>

    {{#if temporaryPassword}}
    <!-- Credentials block (manual onboarding only) -->
    <tr>
      <td style="padding:0 24px 16px 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;">
          <tr>
            <td style="padding:14px 16px;">
              <p style="margin:0 0 10px 0;font-size:13px;font-weight:700;color:#111111;text-transform:uppercase;letter-spacing:0.5px;">Your Login Credentials</p>
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="padding:6px 0;font-size:13px;color:#6b7280;width:130px;vertical-align:top;">Email</td>
                  <td style="padding:6px 0;font-size:13px;color:#111111;font-family:monospace;">{{loginEmail}}</td>
                </tr>
                <tr>
                  <td style="padding:6px 0;font-size:13px;color:#6b7280;vertical-align:top;">Temporary Password</td>
                  <td style="padding:6px 0;font-size:14px;font-weight:700;color:#b45309;font-family:monospace;letter-spacing:1px;">{{temporaryPassword}}</td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px 16px 24px;">
        <p style="margin:0;font-size:13px;color:#dc2626;line-height:1.5;">
          ⚠️ This is a temporary password. Please log in and change it immediately.
        </p>
      </td>
    </tr>
    {{/if}}

    <tr>
      <td style="padding:0 24px 20px 24px;">
        <a href="https://mega.nz/file/LigSjJjS#9n4l61dZmIjsDUMOgX_9wDc8l8dae5cr-JdttGHndBo" style="display:inline-block;padding:10px 20px;background-color:#E5A503;color:#ffffff;font-size:13px;font-weight:600;text-decoration:none;border-radius:4px;">Download the app</a>
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="background-color:#e5e7eb;font-size:0;line-height:0;">&nbsp;</td></tr></table>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px;">
        <p style="margin:0;font-size:12px;color:#9ca3af;line-height:1.5;">&copy; {{year}} Asoose. All rights reserved.</p>
      </td>
    </tr>
  </table>
</body>
</html>