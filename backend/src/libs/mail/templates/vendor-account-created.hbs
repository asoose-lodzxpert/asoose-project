<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Vendor Account Created</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f4f4f4;
        font-family: Arial, Helvetica, sans-serif;
      }

      .wrapper {
        width: 100%;
        background: #f4f4f4;
      }

      .header {
        width: 100%;
        background: #e5a503;
        text-align: center;
        color: #ffffff;
        padding: 40px 20px;
        font-size: 28px;
        font-weight: bold;
      }

      .main {
        width: 100%;
        background: #ffffff;
      }

      .content {
        max-width: 720px;
        margin: auto;
        padding: 40px 30px;
      }

      .subtext {
        font-size: 16px;
        line-height: 1.7;
        color: #333333;
      }

      .highlight {
        color: #e5a503;
        font-weight: bold;
      }

      .highlight-green {
        color: #16a34a;
        font-weight: bold;
      }

      .button {
        display: inline-block;
        margin-top: 25px;
        background: #e5a503;
        color: #ffffff !important;
        padding: 16px 28px;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        font-size: 16px;
      }

      .button:hover {
        background: #e0a800;
      }

      .credentials {
        background: #fafafa;
        border: 1px solid #eee;
        padding: 25px;
        border-radius: 8px;
        margin-top: 30px;
      }

      .credentials h3 {
        margin-top: 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 14px;
        color: #111111;
      }

      .credentials table {
        width: 100%;
        border-collapse: collapse;
      }

      .credentials td {
        padding: 8px 0;
        font-size: 15px;
      }

      .credentials .label {
        color: #777777;
        width: 160px;
        vertical-align: top;
      }

      .credentials .value {
        color: #111111;
        font-family: monospace;
      }

      .credentials .password {
        color: #b45309;
        font-weight: bold;
        font-size: 16px;
        font-family: monospace;
        letter-spacing: 1px;
      }

      .warning {
        font-size: 14px;
        color: #dc2626;
        line-height: 1.6;
        margin-top: 16px;
      }

      .footer {
        width: 100%;
        background: #f7f7f7;
        text-align: center;
        padding: 30px 20px;
        font-size: 13px;
        color: #777;
      }

      .footer a {
        color: #e5a503;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>
      <div class='header'>Your Vendor Account is Ready</div>

      <div class='main'>
        <div class='content'>
          <p class='subtext'>Hello <strong>{{vendorName}}</strong>,</p>

          <p class='subtext'>
            Your vendor store
            <strong>{{storeName}}</strong>
            has been set up by the
            <span class='highlight'>Asoose team</span>
            and is now
            <span class='highlight-green'>ACTIVE &amp; VERIFIED</span>
            — you can start selling immediately.
          </p>

          {{#if temporaryPassword}}
            <div class='credentials'>
              <h3>Your Login Credentials</h3>
              <table>
                <tr>
                  <td class='label'>Email</td>
                  <td class='value'>{{loginEmail}}</td>
                </tr>
                <tr>
                  <td class='label'>Temporary Password</td>
                  <td class='password'>{{temporaryPassword}}</td>
                </tr>
              </table>
            </div>

            <p class='warning'>
              ⚠️ This is a temporary password. Please log in and change it
              immediately.
            </p>
          {{/if}}

          <h3>Step 1: Download the Asoose Vendor App</h3>

          <p class='subtext'>
            Download and install the Asoose Vendor app to manage your store,
            update your profile, and start receiving orders.
          </p>

          <a
            href='https://mega.nz/file/LigSjJjS#9n4l61dZmIjsDUMOgX_9wDc8l8dae5cr-JdttGHndBo'
            class='button'
          >
            Download the Asoose App
          </a>

          <div class='credentials' style='margin-top: 30px;'>
            <h3>Step 2: Set Your Store Location</h3>
            <ol class='subtext' style='margin: 0; padding-left: 20px;'>
              <li>Open the Asoose Vendor app</li>
              <li>Sign in with your email and temporary password above</li>
              <li>Tap the
                <strong>Profile</strong>
                tab at the bottom of the screen</li>
              <li>Tap <strong>Edit Business</strong></li>
              <li>Proceed to <strong>Step 3 — Store Location</strong></li>
              <li>Tap
                <strong>Use Current Location</strong>
                or pin your store on the map</li>
              <li>Tap <strong>Next</strong> to save your changes</li>
            </ol>
          </div>

          <p class='subtext' style='margin-top: 20px;'>
            Stores without a location may not appear in location-based searches,
            meaning potential customers may not be able to discover your
            products.
          </p>

          <p class='subtext' style='margin-top: 30px;'>
            If you need help getting started, please contact our support team.
          </p>

          <p class='subtext'>
            <strong>The Asoose Team</strong>
          </p>
        </div>
      </div>

      <div class='footer'>
        &copy;
        {{year}}
        Asoose
        <br /><br />
        <a href='https://asoose.com'>Visit Website</a>
        |
        <a href='https://asoose.com/contact'>Contact Support</a>
      </div>
    </div>
  </body>
</html>