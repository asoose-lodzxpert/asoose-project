<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Welcome to Asoose</title>
  </head>
  <body
    style='margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f4f4;'
  >
    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background-color: #f4f4f4; padding: 20px;'
    >
      <tr>
        <td align='center'>
          <table
            width='600'
            cellpadding='0'
            cellspacing='0'
            style='background-color: #ffffff; border-radius: 8px; overflow: hidden;'
          >
            <!-- Header -->
            <tr>
              <td
                style='background-color: #E5A503; padding: 40px 30px; text-align: center;'
              >
                <h1
                  style='color: #ffffff; margin: 0 0 10px 0; font-size: 32px;'
                >🎉 Welcome to Asoose!</h1>
                <p style='color: #ffffff; margin: 0; font-size: 16px;'>Your
                  vendor account is ready</p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style='padding: 40px 30px;'>
                <p
                  style='color: #333333; font-size: 16px; line-height: 1.6; margin-bottom: 20px;'
                >
                  Hi
                  {{vendorName}},
                </p>

                <p
                  style='color: #333333; font-size: 16px; line-height: 1.6; margin-bottom: 30px;'
                >
                  Congratulations! Your vendor account has been successfully
                  created. You can now start selling on Asoose.
                </p>

                <!-- Store Info Box -->
                <div
                  style='background-color: #f8f9fa; border-radius: 8px; padding: 20px; margin-bottom: 30px;'
                >
                  <p
                    style='color: #666666; font-size: 14px; margin: 0 0 10px 0;'
                  >Your Store:</p>
                  <h2
                    style='color: #E5A503; font-size: 24px; margin: 0;'
                  >{{storeName}}</h2>
                </div>

                <p
                  style='color: #333333; font-size: 16px; line-height: 1.6; margin-bottom: 30px;'
                >
                  Get started by setting up your products and managing your
                  store from the dashboard.
                </p>

                <div style='text-align: center; margin-top: 30px;'>
                  <a
                    href='{{dashboardUrl}}'
                    style='background-color: #E5A503; color: #ffffff; padding: 15px 40px; text-decoration: none; border-radius: 5px; display: inline-block; font-size: 16px; font-weight: bold;'
                  >
                    Go to Dashboard
                  </a>
                </div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style='background-color: #f8f9fa; padding: 20px 30px; text-align: center; border-top: 1px solid #e0e0e0;'
              >
                <p style='color: #999999; font-size: 12px; margin: 0;'>
                  ©
                  {{year}}
                  Asoose. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>