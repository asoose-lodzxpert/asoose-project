<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Sign-In Detected</title>
</head>
<body style="margin:0;padding:0;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;">
    <tr>
      <td style="padding:20px 24px 16px 24px;">
        <span style="font-size:15px;font-weight:700;color:#000000;letter-spacing:-0.2px;">Asoose</span>
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="background-color:#e5e7eb;font-size:0;line-height:0;">&nbsp;</td></tr></table>
      </td>
    </tr>
    <tr>
      <td style="padding:20px 24px 16px 24px;">
        <p style="margin:0;font-size:15px;font-weight:700;color:#111111;">New Sign-In to Your Account</p>
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="background-color:#e5e7eb;font-size:0;line-height:0;">&nbsp;</td></tr></table>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px;">
        <p style="margin:0;font-size:14px;color:#374151;line-height:1.6;">Hi {{vendorName}}, a new sign-in was detected on your vendor account.</p>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px 0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;">Time</td>
          <td style="padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;">{{timestamp}}</td>
        </tr>
        <tr>
          <td style="padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;">Device</td>
          <td style="padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;">{{device}}</td>
        </tr>
        <tr>
          <td style="padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;">Location</td>
          <td style="padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;">{{location}}</td>
        </tr>
        <tr>
          <td style="padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;">IP Address</td>
          <td style="padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;">{{ipAddress}}</td>
        </tr>
        </table>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px;">
        <p style="margin:0;font-size:14px;color:#374151;line-height:1.6;">If this was you, no action is needed. If you did not sign in, secure your account immediately.</p>
      </td>
    </tr>
    <tr>
      <td style="padding:20px 24px 16px 24px;">
        <a href="{{securityUrl}}" style="display:inline-block;padding:10px 20px;background-color:#E5A503;color:#ffffff;font-size:13px;font-weight:600;text-decoration:none;">Review Security Settings</a>
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="background-color:#e5e7eb;font-size:0;line-height:0;">&nbsp;</td></tr></table>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px;">
        <p style="margin:0;font-size:12px;color:#9ca3af;line-height:1.5;">&copy; {{year}} Asoose. All rights reserved.</p>
      </td>
    </tr>
  </table>
</body>
</html>