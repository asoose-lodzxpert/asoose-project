<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>High Value Withdrawal Alert</title>
  </head>
  <body
    style='margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f4f4;'
  >
    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background-color: #f4f4f4; padding: 20px;'
    >
      <tr>
        <td align='center'>
          <table
            width='600'
            cellpadding='0'
            cellspacing='0'
            style='background-color: #ffffff; border-radius: 8px; overflow: hidden;'
          >
            <!-- Header -->
            <tr>
              <td
                style='background-color: #E5A503; padding: 30px; text-align: center;'
              >
                <h1 style='color: #ffffff; margin: 0; font-size: 24px;'>High
                  Value Withdrawal Alert</h1>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style='padding: 40px 30px;'>
                <p
                  style='color: #333333; font-size: 16px; line-height: 1.6; margin-bottom: 20px;'
                >
                  Administrator Alert,
                </p>

                <p
                  style='color: #d32f2f; font-size: 16px; font-weight: bold; line-height: 1.6; margin-bottom: 20px;'
                >
                  A high-value withdrawal has been processed on the platform.
                  Please review the details below.
                </p>

                <div
                  style='background-color: #f9f9f9; padding: 20px; border-left: 4px solid #d32f2f; margin-bottom: 20px;'
                >
                  <p
                    style='color: #333333; font-size: 15px; margin: 0 0 10px 0;'
                  >
                    <strong>Entity Type:</strong>
                    {{entityType}}
                  </p>
                  <p
                    style='color: #333333; font-size: 15px; margin: 0 0 10px 0;'
                  >
                    <strong>Amount:</strong>
                    NGN
                    {{formatCurrency amount}}
                  </p>
                  <p
                    style='color: #333333; font-size: 15px; margin: 0 0 10px 0;'
                  >
                    <strong>Account Name:</strong>
                    {{accountName}}
                  </p>
                  <p
                    style='color: #333333; font-size: 15px; margin: 0 0 10px 0;'
                  >
                    <strong>Account Number:</strong>
                    {{accountNumber}}
                  </p>
                  <p style='color: #333333; font-size: 15px; margin: 0;'>
                    <strong>Bank Code:</strong>
                    {{bankCode}}
                  </p>
                </div>

                <p
                  style='color: #666666; font-size: 14px; line-height: 1.6; margin-bottom: 20px;'
                >
                  This notification is sent for compliance and audit purposes.
                  Please ensure this transaction is legitimate and follows all
                  platform policies.
                </p>

                <p
                  style='color: #333333; font-size: 16px; line-height: 1.6; margin-bottom: 30px;'
                >
                  Best regards,
                  <br />
                  Asoose Compliance Team
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style='background-color: #f4f4f4; padding: 20px; text-align: center; border-top: 1px solid #e0e0e0;'
              >
                <p style='color: #999999; font-size: 12px; margin: 0;'>
                  This is a confidential administrative notification.
                </p>
                <p style='color: #999999; font-size: 12px; margin: 5px 0 0 0;'>
                  Asoose Platform
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>