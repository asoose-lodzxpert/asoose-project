<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>High Value Withdrawal Alert</title>
</head>
<body style="margin:0;padding:0;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;">
    <tr>
      <td style="padding:20px 24px 16px 24px;">
        <span style="font-size:15px;font-weight:700;color:#000000;letter-spacing:-0.2px;">Asoose</span>
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="background-color:#e5e7eb;font-size:0;line-height:0;">&nbsp;</td></tr></table>
      </td>
    </tr>
    <tr>
      <td style="padding:20px 24px 16px 24px;">
        <p style="margin:0;font-size:15px;font-weight:700;color:#111111;">High Value Withdrawal Alert</p>
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="background-color:#e5e7eb;font-size:0;line-height:0;">&nbsp;</td></tr></table>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px;">
        <p style="margin:0;font-size:14px;color:#374151;line-height:1.6;">This is an automated compliance alert. A high-value withdrawal has been processed on the platform.</p>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px 0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;">Entity Type</td>
          <td style="padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;">{{entityType}}</td>
        </tr>
        <tr>
          <td style="padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;">Amount</td>
          <td style="padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;">NGN {{formatCurrency amount}}</td>
        </tr>
        <tr>
          <td style="padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;">Account Name</td>
          <td style="padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;">{{accountName}}</td>
        </tr>
        <tr>
          <td style="padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;">Account Number</td>
          <td style="padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;">{{accountNumber}}</td>
        </tr>
        <tr>
          <td style="padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;">Bank Code</td>
          <td style="padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;">{{bankCode}}</td>
        </tr>
        </table>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px;">
        <p style="margin:0;font-size:14px;color:#374151;line-height:1.6;">Verify this transaction is legitimate and complies with platform policies.</p>
      </td>
    </tr>

    <tr>
      <td style="padding:0 24px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="background-color:#e5e7eb;font-size:0;line-height:0;">&nbsp;</td></tr></table>
      </td>
    </tr>
    <tr>
      <td style="padding:16px 24px;">
        <p style="margin:0;font-size:12px;color:#9ca3af;line-height:1.5;">This is a confidential administrative notification. &mdash; Asoose Compliance Team</p>
      </td>
    </tr>
  </table>
</body>
</html>