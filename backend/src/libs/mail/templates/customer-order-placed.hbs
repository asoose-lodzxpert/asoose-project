<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Order Placed</title>
  </head>
  <body
    style='margin:0;padding:0;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;'
  >
    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      border='0'
      style='background-color:#ffffff;'
    >
      <tr>
        <td style='padding:20px 24px 16px 24px;'>
          <span
            style='font-size:15px;font-weight:700;color:#000000;letter-spacing:-0.2px;'
          >Asoose</span>
        </td>
      </tr>

      <tr>
        <td style='padding:0 24px;'>
          <table width='100%' cellpadding='0' cellspacing='0' border='0'><tr><td
                height='1'
                style='background-color:#e5e7eb;font-size:0;line-height:0;'
              >&nbsp;</td></tr></table>
        </td>
      </tr>
      <tr>
        <td style='padding:20px 24px 16px 24px;'>
          <p
            style='margin:0;font-size:15px;font-weight:700;color:#111111;'
          >Order Confirmed</p>
        </td>
      </tr>

      <tr>
        <td style='padding:0 24px;'>
          <table width='100%' cellpadding='0' cellspacing='0' border='0'><tr><td
                height='1'
                style='background-color:#e5e7eb;font-size:0;line-height:0;'
              >&nbsp;</td></tr></table>
        </td>
      </tr>
      <tr>
        <td style='padding:16px 24px;'>
          <p style='margin:0;font-size:14px;color:#374151;line-height:1.6;'>Hi
            {{name}}, your order from
            <strong>{{storeName}}</strong>
            has been placed successfully.</p>
        </td>
      </tr>
      <tr>
        <td style='padding:16px 24px 0 24px;'>
          <table width='100%' cellpadding='0' cellspacing='0' border='0'>
            <tr>
              <td
                style='padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;'
              >Order ID</td>
              <td
                style='padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;'
              >{{orderId}}</td>
            </tr>
            <tr>
              <td
                style='padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;'
              >Total</td>
              <td
                style='padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;'
              >&#8358;{{total}}</td>
            </tr>
            <tr>
              <td
                style='padding:10px 0;font-size:13px;color:#6b7280;border-bottom:1px solid #f3f4f6;width:150px;vertical-align:top;'
              >Store</td>
              <td
                style='padding:10px 0;font-size:13px;color:#111111;border-bottom:1px solid #f3f4f6;'
              >{{storeName}}</td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td style='padding:16px 24px 0 24px;'>
          <p
            style='margin:0 0 8px 0;font-size:13px;font-weight:600;color:#111111;'
          >Items</p>
          <table width='100%' cellpadding='0' cellspacing='0' border='0'>
            {{#each items}}
              <tr>
                <td
                  style='padding:8px 0;font-size:13px;color:#374151;border-bottom:1px solid #f3f4f6;'
                >{{this}}</td>
              </tr>
            {{/each}}
          </table>
        </td>
      </tr>
      <tr>
        <td style='padding:20px 24px 16px 24px;'>
          <a
            href='{{url}}'
            style='display:inline-block;padding:10px 20px;background-color:#E5A503;color:#ffffff;font-size:13px;font-weight:600;text-decoration:none;'
          >Track Order</a>
        </td>
      </tr>

      <tr>
        <td style='padding:0 24px;'>
          <table width='100%' cellpadding='0' cellspacing='0' border='0'><tr><td
                height='1'
                style='background-color:#e5e7eb;font-size:0;line-height:0;'
              >&nbsp;</td></tr></table>
        </td>
      </tr>
      <tr>
        <td style='padding:16px 24px;'>
          <p style='margin:0;font-size:12px;color:#9ca3af;line-height:1.5;'>This
            is an automated notification. Do not reply to this email. &mdash;
            Asoose Lodzxpert Nig. Ltd</p>
        </td>
      </tr>
    </table>
  </body>
</html>