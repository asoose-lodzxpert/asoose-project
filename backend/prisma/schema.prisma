generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//// =====================
//// ENUMS
//// =====================

enum UserRole {
  CUSTOMER
  VENDOR
  RIDER
  ADMIN
  DRIVER
  SUPER_ADMIN
  ADMIN_MANAGER // Operations (Riders/Vendors) but no Financials
  ADMIN_SUPPORT // View Only + Disputes
  ADMIN_FINANCE // Transactions & Payouts Only
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  BANNED
}

enum StoreType {
  RESTAURANT
  GROCERY
  PHARMACY
  MARKET
  FASHION
  ELECTRONICS
  FURNITURE
  BEAUTY
  HEALTH
  EDUCATION
  SERVICES
  AUTOMOTIVE
  TRAVEL
  ENTERTAINMENT
  RETAIL
  ONLINE
  MANUFACTURING
  LOGISTICS
  OTHER
}

enum StoreStatus {
  ACTIVE
  PENDING
  SUSPENDED
  CLOSED_PERMANENTLY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  DISABLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
  REJECTED
}

enum RideStatus {
  PENDING      // Payment not yet confirmed
  REQUESTED    // Payment confirmed, searching for driver
  ACCEPTED     // Driver accepted
  ARRIVED
  IN_PROGRESS  // Trip started
  COMPLETED    // Trip completed
  CANCELLED    // Trip cancelled
}

enum DeliveryStatus {
  PENDING      // Payment not yet confirmed
  REQUESTED    // Payment confirmed, searching for rider
  ASSIGNED     // Rider assigned
  ACCEPTED     // Rider accepted the delivery
  PICKED_UP    // Package picked up
  IN_TRANSIT   // Package in transit to customer
  DELIVERED    // Package delivered
  CANCELLED    // Delivery cancelled
}

enum PayoutStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  PAID
  FAILED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum DisputeRefundStatus {
  IDLE
  PROCESSING
  COMPLETED
  FAILED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
  BANK_TRANSFER
}

// NEW: Transaction Types for Ledger
enum TransactionType {
  PAYMENT_RECEIVED      // Customer pays for order/ride
  COMMISSION_DEDUCTED   // Platform takes commission
  VENDOR_EARNING        // Store receives net amount
  RIDER_EARNING         // Rider receives ride/delivery fee
  PAYOUT_REQUESTED      // Vendor/Rider requests withdrawal
  PAYOUT_COMPLETED      // Bank transfer successful
  PAYOUT_FAILED         // Bank transfer failed
  REFUND_ISSUED         // Customer refunded
  ADJUSTMENT            // Manual admin adjustment
  WALLET_TOPUP          // Direct wallet addition
}

// NEW: Entity types for wallet tracking
enum WalletEntityType {
  STORE
  RIDER
  PLATFORM
}

// NEW: Transaction status
enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

//// =====================
//// USER & AUTH
//// =====================

model SystemSetting {
  key         String   @id
  value       String  
  description String?
  category    String   
  updatedAt   DateTime @updatedAt
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  phone     String?
  image     String?
  googleId  String?    @unique @map("google_id")
  appleId   String?    @unique @map("apple_id")
  notifications Notification[]
  fcmToken  String?  @map("fcm_token")
  expoPushToken String? @map("expo_push_token")
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  verificationStatus String? @default("UNVERIFIED")
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  orders       Order[]
  orderGroups  OrderGroup[]
  addresses    Address[]
  reviews      Review[]
  activityLogs ActivityLog[]
  disputesOpened    Dispute[]        @relation("DisputeOpener")
  disputesTargeted  Dispute[]        @relation("DisputeTarget")
  disputeMessages   DisputeMessage[]
  payments     Payment[]

  // Trip Relations
  rides      Ride[]     @relation("RideCustomer")
  deliveries Delivery[] @relation("DeliveryCustomer")

  // Emergency Contacts
  emergencyContacts    EmergencyContact[]

  // Notification Preferences
  notificationsPreferences Json? // Stores notification preferences

  // Wallet
  walletBalance                Float   @default(0) @map("wallet_balance")
  walletBalanceHidden          Boolean @default(false) @map("wallet_balance_hidden")   // Cross-device balance visibility toggle

  // Paystack — wallet top-up via Dedicated Virtual Account
  paystackCustomerCode         String? @unique @map("paystack_customer_code")          // From POST /customer
  dedicatedVirtualAccountNumber String? @map("dedicated_virtual_account_number")       // DVA account number
  dedicatedVirtualAccountBank  String? @map("dedicated_virtual_account_bank")         // DVA bank name

  // Saved payment cards (Paystack tokenization)
  savedCards SavedCard[]

  @@index([email])
  @@index([googleId])
  @@index([appleId])
  @@index([role, status])
  @@index([createdAt])
  @@index([status, createdAt(sort: Desc)])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  vendorId  String?
  riderId   String?
  title     String
  message   String
  type      String   // e.g., ORDER, PAYOUT, SYSTEM
  category  String?  // e.g., ORDER_CREATED, ORDER_UPDATE, PAYOUT_PROCESSED
  isRead    Boolean  @default(false)
  metadata  Json?    // Store orderId, storeId, etc.
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rider  Rider?  @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([vendorId, isRead])
  @@index([riderId, isRead])
  @@index([createdAt(sort: Desc)])
  @@index([type])
}

model Address {
  id        String  @id @default(uuid())

  // 1. Make User Optional (Customers)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 2. Add Vendor Relation (Store Locations)
  vendorId  String?
  vendor    Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  phone     String?
  label     String
  street    String
  city      String
  state     String
  lat       Float
  lng       Float
  isDefault Boolean @default(false)

  // Reverse Relations
  ridesAsPickup       Ride[]     @relation("RidePickup")
  ridesAsDropoff      Ride[]     @relation("RideDropoff")
  deliveriesAsPickup  Delivery[] @relation("DeliveryPickup")
  deliveriesAsDropoff Delivery[] @relation("DeliveryDropoff")

  // Indexes for performance
  @@index([userId])
  @@index([userId, isDefault])
  @@index([vendorId])            // Fixed: Added index for vendor lookups
  @@index([vendorId, isDefault]) // Fixed: Added compound index for vendor defaults
}

//// =====================
//// EMERGENCY CONTACT
//// =====================

model EmergencyContact {
  id          String   @id @default(uuid())
  userId      String?
  riderId     String?
  vendorId    String?
  name        String
  phone       String
  relationship String? // e.g., "Spouse", "Parent", "Colleague"
  isPrimary   Boolean  @default(false)

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rider       Rider?   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  vendor      Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, phone])
  @@unique([riderId, phone])
  @@unique([vendorId, phone])
  @@index([userId])
  @@index([riderId])
  @@index([vendorId])
  @@index([isPrimary])
}

//// =====================
//// RIDER & LOGISTICS
//// =====================

model Rider {
  id              String     @id @default(uuid())
  name            String
  email           String     @unique
  countryCode     String
  phone           String
  password        String
  image           String?
  role            UserRole   @default(RIDER) // RIDER or DRIVER
  status          UserStatus @default(PENDING)
  expoPushToken   String?    // Expo push notification token
  fcmToken        String?    // Firebase Cloud Messaging token
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Live Status (Critical for Matching)
  isOnline   Boolean @default(false)
  currentLat Float?
  currentLng Float?

  // Financials & Stats
  walletBalance  Float @default(0)
  commissionRate Float @default(20.0) // Platform commission percentage
  rating         Float @default(5.0)
  totalRides     Int   @default(0)

  // Relations
  payouts                  RiderPayout[]
  bankAccount              BankAccount?
  vehicle                  Vehicle?
  documents                RiderDocument[]
  emergencyContacts        EmergencyContact[]
  notificationSettings     RiderNotificationSettings? @relation("RiderNotificationSettings")
  rides                    Ride[]         @relation("RideRider")
  deliveries               Delivery[]     @relation("DeliveryRider")
  notifications            Notification[]
  notificationsPreferences Json? // Stores notification preferences

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([isOnline, currentLat, currentLng])
  @@index([rating])
  @@index([walletBalance])
  @@index([totalRides, rating])
  @@index([status, createdAt(sort: Desc)])
}

model RiderPayout {
  id        String        @id @default(uuid())
  riderId   String
  amount    Float
  status    PayoutStatus  @default(PENDING)
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?       // Transaction ID from bank/payment gateway
  processedAt DateTime?
  createdAt   DateTime    @default(now())
  bankAccountId String?
  rider        Rider         @relation(fields: [riderId], references: [id], onDelete: Cascade)
  transactions Transaction[] // Link to transaction ledger

  @@index([riderId, status])
  @@index([createdAt])
  @@index([status, createdAt(sort: Desc)])
}

model Vehicle {
  id          String @id @default(uuid())
  riderId     String @unique
  rider       Rider  @relation(fields: [riderId], references: [id], onDelete: Cascade)

  type        String
  brand       String
  model       String
  plateNumber String @unique
  color       String
  year        Int

  documents VehicleDocument[]

  @@index([plateNumber])
}

model RiderDocument {
  id        String             @id @default(uuid())
  riderId   String
  rider     Rider              @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type      String
  url       String
  status    VerificationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([riderId, status])
}

model RiderNotificationSettings {
  id        String   @id @default(uuid())
  riderId   String   @unique
  rider     Rider    @relation("RiderNotificationSettings", fields: [riderId], references: [id], onDelete: Cascade)
  
  // Master toggle
  masterEnabled Boolean @default(true)
  
  // Delivery notifications
  newOrders     Boolean @default(true)
  orderUpdates  Boolean @default(true)
  vibration     Boolean @default(true)
  
  // Earnings notifications
  paymentUpdates Boolean @default(true)
  dailySummary   Boolean @default(false)
  weeklySummary  Boolean @default(true)
  
  // Account & Safety
  securityAlerts Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riderId])
}

model VehicleDocument {
  id        String    @id @default(uuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      String
  url       String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([vehicleId])
  @@index([expiresAt])
}

//// =====================
//// STORE / VENDOR
//// =====================

model Vendor {
  id                     String     @id @default(uuid())
  name                   String
  email                  String     @unique
  countryCode            String
  phone                  String
  businessType           String
  employees              String
  password               String
  image                  String?
  status                 UserStatus @default(PENDING)
  expoPushToken          String?    // Expo push notification token
  fcmToken               String?    // Firebase Cloud Messaging token

  // Account Deletion Fields
  deletionStatus         String?    // PENDING, APPROVED, REJECTED, null (not requested)
  deletionRequestedAt    DateTime?
  deletionReasons        String[]   @default([])
  deletionAdditionalInfo String?
  deletionApprovedBy     String?    // Admin user ID who approved
  deletionApprovedAt     DateTime?

  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  // Relations
  store                    Store?
  documents                VendorDocument[]
  emergencyContacts        EmergencyContact[]
  notifications            Notification[]
  notificationsPreferences Json?      // Stores notification preferences for the vendor
  addresses                Address[]  // Fixed: Added relation to Address
}

model Store {
  id           String             @id @default(uuid())
  name         String
  description  String             @default("No description provided")
  slug         String             @unique
  type         StoreType
  address      String?
  lat          Float?
  lng          Float?
  logo         String?
  banner       String?
  openHours    Json?
  rating       Float              @default(0)
  ratingCount  Int                @default(0)
  status       StoreStatus        @default(PENDING)
  verification VerificationStatus @default(PENDING)
  vendorId     String             @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  walletBalance Float @default(0)
  // Operational Settings
  prepTime       Int     @default(20)
  isOpen         Boolean @default(true)
  commissionRate Float   @default(10.0)

  // Analytics
  totalRevenue  Float @default(0)
  totalOrders   Int   @default(0)
  

  // Relations
  vendor           Vendor?           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  products         Product[]
  orders           Order[]
  reviews          Review[]
  vendorPayouts    VendorPayout[]
  openingHours     OpeningHour[]
  bankAccount      BankAccount?
  paystackSubaccountCode String? @map("paystack_subaccount_code") // For split-payment settlements
  storeLogs        StoreLog[]

  

  @@index([vendorId])
  @@index([status, verification])
  @@index([type, status])
  @@index([lat, lng])
  @@index([slug])
  @@index([rating])
  @@index([walletBalance])
}

model OpeningHour {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  openTime  String
  closeTime String

  @@unique([storeId, dayOfWeek])
  @@index([storeId])
}

model BankAccount {
  id             String        @id @default(uuid())
  
  // Make storeId optional
  storeId        String?       @unique 
  store          Store?        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Add riderId relation
  riderId        String?       @unique
  rider          Rider?        @relation(fields: [riderId], references: [id], onDelete: Cascade)

  bankName       String
  bankCode       String        // Bank code for NUBAN verification
  accountNumber  String
  accountName    String
  currency       String        @default("NGN")

  // Payment Gateway Recipient Codes (for disbursements)
  paystackRecipientCode    String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([accountNumber])
  @@index([bankCode])
}

model VendorDocument {
  id           String             @id @default(uuid())
  vendorId     String
  name         String             // e.g., "businessRegCert", "taxIdDoc", "proofOfAddress"
  fileName     String
  url          String
  status       VerificationStatus @default(PENDING)
  uploadedDate DateTime           @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
  @@index([vendorId, name])
}

model VendorPayout {
  id               String       @id @default(uuid())
  storeId          String
  bankAccountId    String?
  amount           Float
  method           String       @default("BANK_TRANSFER")
  status           PayoutStatus @default(PENDING)
  reference        String?
  rejectionReason  String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  transactions Transaction[] // NEW: Link to transaction ledger

  @@index([storeId, status])
  @@index([createdAt])
  @@index([status, createdAt(sort: Desc)])
}

model StoreLog {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  action      String
  details     String?
  performedBy String?
  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
}

//// =====================
//// PRODUCT & MENU
//// =====================

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([name])
}

model Product {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  price       Float
  images      String[]      @default([])
  status      ProductStatus @default(ACTIVE)
  storeId     String
  stock       Int           @default(0)
  categoryId  String
  inventory   Int?
  salesCount  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]

  @@index([storeId, status])
  @@index([categoryId, status])
  @@index([salesCount(sort: Desc)])
  @@index([slug])
}

model ModifierGroup {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name      String
  minSelect Int    @default(0)
  maxSelect Int    @default(1)

  modifiers Modifier[]

  @@index([productId])
}

model Modifier {
  id              String        @id @default(uuid())
  modifierGroupId String
  group           ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  name  String
  price Float  @default(0)

  orderItemModifiers OrderItemModifier[]

  @@index([modifierGroupId])
}

//// =====================
//// ORDER & TRANSACTIONS
//// =====================

model Order {
  id        String      @id @default(uuid())
  userId    String
  storeId   String
  total     Float
  status    OrderStatus @default(PENDING)
  orderGroupId  String?     // Nullable for backward compatibility
  orderGroup    OrderGroup? @relation(fields: [orderGroupId], references: [id])
  paymentStatus String?  @default("PENDING") // PENDING, PAID, FAILED
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  disputes  Dispute[]
  transactions Transaction[]
  deliveredAt DateTime?
  cancelledAt DateTime?

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  store    Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)

  items    OrderItem[]
  delivery Delivery?   @relation("OrderDelivery")
  payment  Payment?    @relation("OrderPayment")

  @@index([userId, status])
  @@index([storeId, status])
  @@index([status, createdAt])
  @@index([createdAt(sort: Desc)])
  @@index([status, deliveredAt(sort: Desc)])
  @@index([createdAt(sort: Desc), status]) 
}

model OrderGroup {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  totalAmount   Float         
  paymentStatus PaymentStatus @default(PENDING)
  
  // Update this line: remove (fields: [paymentId], references: [id])
  payment       Payment?      @relation("GroupPayment") 
  transactions  Transaction[]
  orders        Order[]       
  createdAt     DateTime      @default(now())
}


model OrderItemModifier {
  id         String    @id @default(uuid())
  orderItemId String
  modifierId  String

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier  @relation(fields: [modifierId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String?

  nameSnap        String
  quantity        Int
  price           Float
  selectedOptions Json?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  modifiers      OrderItemModifier[] 

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String?       @unique
  rideId        String?       @unique
  deliveryId    String?       @unique
  userId        String
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // === Multi-Vendor Cart Field (Fixed) ===
  // This connects the Payment to the Group of orders
  orderGroupId  String?       @unique
  orderGroup    OrderGroup?   @relation("GroupPayment", fields: [orderGroupId], references: [id])
  // =======================================

  // Payment Gateway Fields
  reference        String    @unique
  gateway          String    // PAYSTACK, FLUTTERWAVE, MONNIFY
  authorizationUrl String?
  accessCode       String?
  accountNumber    String?
  bankName         String?
  accountName      String?
  expiresAt        DateTime?
  paidAt           DateTime?
  verifiedAt       DateTime?
  customerEmail    String?
  customerName     String?
  metadata         Json?
  paymentStatus    String?   // PAID, FAILED, PENDING (for order relation)

  // Relations
  disputes      Dispute[]
  order         Order?        @relation("OrderPayment", fields: [orderId], references: [id], onDelete: Cascade)
  ride          Ride?         @relation("RidePayment", fields: [rideId], references: [id], onDelete: Cascade)
  delivery      Delivery?     @relation("DeliveryPayment", fields: [deliveryId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions  Transaction[] // Link to transaction ledger

  // Indexes
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([transactionId])
  @@index([orderId])
  @@index([rideId])
  @@index([deliveryId])
  @@index([reference])
  @@index([gateway, status])
  @@index([status, createdAt(sort: Desc), amount])
}

// Saved card tokenization (Paystack authorization codes stored server-side)
model SavedCard {
  id                String   @id @default(uuid())
  userId            String
  authorizationCode String   // Paystack authorization_code (encrypted at app layer)
  last4             String
  brand             String   // visa, mastercard, etc.
  expiryMonth       String
  expiryYear        String
  bin               String?
  bank              String?
  cardType          String?
  accountName       String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, last4, expiryYear, expiryMonth])
  @@index([userId])
  @@map("saved_cards")
}

//// =====================
//// RIDES & DELIVERIES
//// =====================

model Ride {
  id               String     @id @default(uuid())
  customerId       String
  riderId          String?
  pickupAddressId  String
  dropoffAddressId String
  status           RideStatus @default(REQUESTED)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  disputes         Dispute[]
  transactions Transaction[]
  idempotencyKey     String?
  // Security
  startOtp           String?
  cancellationReason String?
  cancelledBy        String?
  cancelledAt        DateTime?

  // Pricing Breakdown
  baseFare        Float?
  distanceFare    Float?
  timeFare        Float?
  surgeMultiplier Float  @default(1.0)
  platformFee     Float?
  driverFee       Float?
  totalFare       Float?

  // Trip Data
  distanceKm  Float?
  durationMin Int?

  // Timestamps
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  customer       User     @relation("RideCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  rider          Rider?   @relation("RideRider", fields: [riderId], references: [id], onDelete: SetNull)
  pickupAddress  Address  @relation("RidePickup", fields: [pickupAddressId], references: [id], onDelete: Restrict)
  dropoffAddress Address  @relation("RideDropoff", fields: [dropoffAddressId], references: [id], onDelete: Restrict)
  payment        Payment? @relation("RidePayment")

  @@index([customerId, status])
  @@index([riderId, status])
  @@index([status, createdAt])
  @@index([createdAt(sort: Desc)])
}

model Delivery {
  id               String         @id @default(uuid())
  orderId          String?        @unique
  customerId       String
  riderId          String?
  pickupAddressId  String
  dropoffAddressId String
  status           DeliveryStatus @default(REQUESTED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  disputes         Dispute[]
  transactions   Transaction[]
  // Security & Proof
  deliveryOtp   String?
  pickupProof   String?
  deliveryProof String?

  // Package Info
  packageDetails String?
  recipientName  String
  recipientPhone String
  weightKg       Float?
  isFragile      Boolean @default(false)

  isPerishable   Boolean @default(false)
  containsLiquid Boolean @default(false)
  declaredValue  Float?  @default(0)     // For insurance/liability

  // Pricing
  deliveryFee Float
  distanceKm  Float?

  // Multi-stop (grouped order) support
  // stops = [{orderId, storeName, pickupAddressId, pickupAddress, status: 'PENDING'|'PICKED_UP'}]
  stops             Json?
  currentStopIndex  Int  @default(0)
  orderGroupId      String?

  // Timestamps
  assignedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  order          Order?   @relation("OrderDelivery", fields: [orderId], references: [id], onDelete: Cascade)
  customer       User     @relation("DeliveryCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  rider          Rider?   @relation("DeliveryRider", fields: [riderId], references: [id], onDelete: SetNull)
  pickupAddress  Address  @relation("DeliveryPickup", fields: [pickupAddressId], references: [id], onDelete: Restrict)
  dropoffAddress Address  @relation("DeliveryDropoff", fields: [dropoffAddressId], references: [id], onDelete: Restrict)
  payment        Payment? @relation("DeliveryPayment")

  @@index([orderId])
  @@index([customerId, status])
  @@index([riderId, status])
  @@index([status, createdAt])
  @@index([createdAt(sort: Desc)])
}

//// =====================
//// NEW: UNIFIED TRANSACTION LEDGER
//// =====================

model Transaction {
  id        String            @id @default(uuid())
  type      TransactionType
  amount    Float
  
  // Entity tracking (who this affects)
  entityType WalletEntityType?
  entityId   String?          // Store ID or RiderProfile ID
  
  // Reference to source transactions
  paymentId       String?   @unique
  vendorPayoutId  String?   @unique
  riderPayoutId   String?   @unique
  
  // Reference to business entities
  orderId         String?
  rideId          String?
  deliveryId      String?

  // === FIX: Add Traceability for Multi-Vendor Orders ===
  orderGroupId    String?
  // ====================================================
  
  // Financial tracking
  balanceBefore Float
  balanceAfter  Float
  
  // Metadata
  description String
  metadata    Json?         // Store extra details like commission rates, reasons, etc.
  
  // Status & audit
  status      TransactionStatus @default(COMPLETED)
  processedBy String?           // Admin user ID if manual adjustment
  createdAt   DateTime          @default(now())
  
  // Relations
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  vendorPayout  VendorPayout? @relation(fields: [vendorPayoutId], references: [id], onDelete: Restrict)
  riderPayout   RiderPayout?  @relation(fields: [riderPayoutId], references: [id], onDelete: Restrict)
  
  delivery      Delivery?     @relation(fields: [deliveryId], references: [id])
  order         Order?        @relation(fields: [orderId], references: [id])
  ride          Ride?         @relation(fields: [rideId], references: [id])
  
  // === FIX: Relation to OrderGroup ===
  orderGroup    OrderGroup?   @relation(fields: [orderGroupId], references: [id])
  // ===================================

  @@index([entityType, entityId, createdAt])
  @@index([type, status, createdAt])
  @@index([paymentId])
  @@index([vendorPayoutId])
  @@index([riderPayoutId])
  @@index([orderId])
  @@index([rideId])
  @@index([deliveryId])
  // === FIX: Index for fast lookups ===
  @@index([orderGroupId])
  // ===================================
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([type, createdAt(sort: Desc), amount])
  @@index([entityType, entityId, type, createdAt])
}

//// =====================
//// REVIEWS & LOGS
//// =====================

model Review {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId, rating])
  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  target    String?
  status    String?
  details   String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([action, createdAt], map: "ActivityLog_action_createdAt_idx")      
  @@index([action, createdAt(sort: Desc)], map: "ActivityLog_action_createdAt_desc_idx")
}

model Dispute {
  id          String         @id @default(uuid())
  status      DisputeStatus  @default(OPEN)
  priority    DisputePriority @default(MEDIUM)
  reason      String         // e.g., "Item missing", "Driver rude"
  description String?        @db.Text
  refundStatus       DisputeRefundStatus @default(IDLE)
  refundIdempotencyKey String?           @unique
  gatewayRefundId    String?
  openedByUserId String
  openedByUser   User   @relation("DisputeOpener", fields: [openedByUserId], references: [id], onDelete: Cascade)

  targetUserId   String?
  targetUser     User?  @relation("DisputeTarget", fields: [targetUserId], references: [id])

  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id])
  rideId      String?
  ride        Ride?      @relation(fields: [rideId], references: [id])
  deliveryId  String?
  delivery    Delivery?  @relation(fields: [deliveryId], references: [id])
  paymentId   String?    // If disputing a specific transaction
  payment     Payment?   @relation(fields: [paymentId], references: [id])

  evidenceImages String[]   // Array of URLs
  adminNotes     String?    @db.Text
  resolution     String?    // Public explanation of the result
  refundAmount   Float?     // If money was returned

  messages       DisputeMessage[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  @@index([status, priority])
  @@index([status, createdAt(sort: Desc)])
  @@index([openedByUserId, status])
  @@index([status, resolvedAt]) 
}

model DisputeMessage {
  id        String   @id @default(uuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  isInternal Boolean @default(false) 
  createdAt DateTime @default(now())
}

model ServiceZone {
  id          String   @id @default(uuid())
  name        String   // e.g. "Abuja Central", "Lagos Island"
  description String?
  
  // Stored as an array of { lat: number, lng: number }
  coordinates Json     
  
  isActive    Boolean  @default(true)
  
  // Operational Rules (Optional MVP overrides)
  basePriceMultiplier Float @default(1.0) // 1.0 = standard, 1.2 = expensive zone
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service_zones")
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String
  buttonText  String   @default("Order Now")
  link        String   @default("/store")
  image       String?  // Optional background image
  type        String   @default("PROMO") // e.g., PROMO, AD, INFO
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([type])
  @@index([priority(sort: Desc)])
}

model Bank {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "Access Bank"
  code      String   @unique // e.g., "044"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  
  @@index([code])
  @@index([name])
}