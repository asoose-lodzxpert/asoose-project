# ===================================
# ASOOSE Backend Environment Variables
# ===================================

# ----------------
# Application
# ----------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ----------------
# Database (PostgreSQL)
# ----------------
# Local Development
DATABASE_URL=postgresql://asoose:asoose_password@localhost:5432/asoose_db?schema=public
DIRECT_URL=postgresql://asoose:asoose_password@localhost:5432/asoose_db?schema=public

# Production (RDS)
# DATABASE_URL=postgresql://asoose_admin:STRONG_PASSWORD@asoose-postgres.xxxxx.us-east-1.rds.amazonaws.com:5432/asoose_db?schema=public
# DIRECT_URL=postgresql://asoose_admin:STRONG_PASSWORD@asoose-postgres.xxxxx.us-east-1.rds.amazonaws.com:5432/asoose_db?schema=public

POSTGRES_USER=asoose
POSTGRES_PASSWORD=asoose_password
POSTGRES_DB=asoose_db

# ----------------
# Redis Cache
# ----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# Matching System Redis (uses separate DB to avoid conflicts)
# If using Railway Redis, you can use DB 1 for matching system
MATCHING_REDIS_DB=1

# Production (ElastiCache or Railway)
# REDIS_HOST=asoose-redis.xxxxx.use1.cache.amazonaws.com
# REDIS_PORT=6379

# ----------------
# MongoDB (Logs)
# ----------------
MONGODB_URI=mongodb://mongo:@shortline.proxy.rlwy.net:13089

# ----------------
# JWT Authentication
# ----------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# ----------------
# Email (SMTP)
# ----------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@asoose.com

# Production (SES)
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USER=your-ses-smtp-username
# EMAIL_PASSWORD=your-ses-smtp-password

# ----------------
# AWS File Storage (Production)
# ----------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-aws-s3-bucket
AWS_S3_PUBLIC_URL=https://your-aws-s3-public-url

# ----------------
# Rate Limiting
# ----------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ----------------
# CORS
# ----------------
CORS_ORIGIN=http://localhost:3001,http://localhost:19006
CORS_CREDENTIALS=true

# ----------------
# Frontend URLs
# ----------------
CUSTOMER_WEB_URL=http://localhost:3001
CUSTOMER_APP_URL=exp://localhost:19000
VENDOR_APP_URL=exp://localhost:19001
RIDER_APP_URL=exp://localhost:19002

# Production URLs
# CUSTOMER_WEB_URL=https://asoose.com
# CUSTOMER_APP_URL=https://app.asoose.com
# VENDOR_APP_URL=https://vendor.asoose.com
# RIDER_APP_URL=https://rider.asoose.com

# ----------------
# Payment (Paystack)
# ----------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx

FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST-xxxxxxxxxxxxx
# ----------------
# Firebase (Admin SDK)
# ----------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
# ----------------
# CORS (already present above, but ensure all keys)
# ----------------
# CORS_ORIGIN=http://localhost:3001,http://localhost:19006
# CORS_CREDENTIALS=true
# ----------------
# Rate Limiting (already present above, but ensure all keys)
# ----------------
# THROTTLE_TTL=60
# THROTTLE_LIMIT=100
# ----------------
# Logging (already present below, but ensure all keys)
# ----------------
# LOG_LEVEL=debug
# LOG_FORMAT=json
# ----------------
# Health Check (already present below, but ensure all keys)
# ----------------
# HEALTH_CHECK_PATH=/health
# ----------------
# General App Port (already present above, but ensure all keys)
# ----------------
# PORT=3000
# ----------------
# Add any other missing variables from .env
# ----------------
CUSTOMER_WEB_URL=http://localhost:3001
CUSTOMER_APP_URL=exp://localhost:19000
VENDOR_APP_URL=exp://localhost:19001
RIDER_APP_URL=exp://localhost:19002
# ----------------
# FCM (Firebase Cloud Messaging) - alternate keys for other projects
# ----------------
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# ----------------
# Payment (Monnify)
# ----------------
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=your-api-key
MONNIFY_SECRET_KEY=your-secret-key
MONNIFY_CONTRACT_CODE=your-contract-code

# Production Monnify
# MONNIFY_BASE_URL=https://api.monnify.com

# ----------------
# Backend URL
# ----------------
# CRITICAL: BACKEND_URL must include the full path prefix /api/v1 because the
# NestJS app uses setGlobalPrefix('api') + URI versioning (v1).
# The Paystack callback_url is constructed as:
#   ${BACKEND_URL}/payment/callback/paystack
# If BACKEND_URL is 'http://localhost:3000' (no /api/v1), Paystack redirects
# the browser to 'http://localhost:3000/payment/callback/paystack' which 404s
# because the actual NestJS route sits at /api/v1/payment/callback/paystack.
BACKEND_URL=http://localhost:3000/api/v1

# Production:
# BACKEND_URL=https://api.yourdomain.com/api/v1

# ----------------
# Frontend URL (used for post-payment browser redirect)
# ----------------
# After the backend's GET /api/v1/payment/callback/paystack verifies the payment,
# it redirects the user's browser to:
#   ${FRONTEND_URL}/payment/callback?reference=...&status=success
# This must be the customer web app URL, NOT the backend URL.
# Without this variable the code falls back to http://localhost:3001 which is
# correct for local dev, but must be set explicitly in staging/production.
FRONTEND_URL=http://localhost:3001

# Production:
# FRONTEND_URL=https://app.yourdomain.com

# ----------------
# Maps API
# ----------------
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ----------------
# NUBAN Account Verification
# ----------------
NUBAN_API_KEY=your-nuban-api-key

# ----------------
# Push Notifications (Firebase Cloud Messaging)
# ----------------
# Get these from Firebase Console: Project Settings > Service Accounts > Generate New Private Key
# Download the JSON file and extract the values below
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# IMPORTANT: 
# 1. Keep the quotes around FCM_PRIVATE_KEY
# 2. Keep the \n characters in the private key
# 3. Never commit the actual .env file with real values
# 4. Add *firebase-adminsdk*.json to .gitignore to prevent credential leaks

# ----------------
# Logging
# ----------------
LOG_LEVEL=debug
LOG_FORMAT=json

# ----------------
# Bull Queue (Optional)
# ----------------
QUEUE_HOST=localhost
QUEUE_PORT=6379
QUEUE_PASSWORD=redis_password

# ----------------
# Health Check
# ----------------
HEALTH_CHECK_PATH=/health

# ----------------
# AWS (Production)
# ----------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
