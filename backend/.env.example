# ===================================
# ASOOSE Backend Environment Variables
# ===================================

# ----------------
# Application
# ----------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ----------------
# Database (PostgreSQL)
# ----------------
# Local Development
DATABASE_URL=postgresql://asoose:asoose_password@localhost:5432/asoose_db?schema=public
DIRECT_URL=postgresql://asoose:asoose_password@localhost:5432/asoose_db?schema=public

# Production (RDS)
# DATABASE_URL=postgresql://asoose_admin:STRONG_PASSWORD@asoose-postgres.xxxxx.us-east-1.rds.amazonaws.com:5432/asoose_db?schema=public
# DIRECT_URL=postgresql://asoose_admin:STRONG_PASSWORD@asoose-postgres.xxxxx.us-east-1.rds.amazonaws.com:5432/asoose_db?schema=public

POSTGRES_USER=asoose
POSTGRES_PASSWORD=asoose_password
POSTGRES_DB=asoose_db

# ----------------
# Redis Cache
# ----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# Production (ElastiCache)
# REDIS_HOST=asoose-redis.xxxxx.use1.cache.amazonaws.com
# REDIS_PORT=6379

# ----------------
# JWT Authentication
# ----------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# ----------------
# Email (SMTP)
# ----------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@asoose.com

# Production (SES)
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USER=your-ses-smtp-username
# EMAIL_PASSWORD=your-ses-smtp-password

# ----------------
# File Storage
# ----------------
# Example environment variables for Railway S3-compatible storage
# Copy this file to `.env` and fill in real values (do not commit real secrets).
RAILWAY_S3_ENDPOINT=https://storage.railway.app
RAILWAY_S3_BUCKET=your-bucket-name
RAILWAY_S3_REGION=auto
RAILWAY_S3_ACCESS_KEY_ID=your-access-key-id
RAILWAY_S3_SECRET_ACCESS_KEY=your-secret-access-key

# ----------------
# Rate Limiting
# ----------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ----------------
# CORS
# ----------------
CORS_ORIGIN=http://localhost:3001,http://localhost:19006
CORS_CREDENTIALS=true

# ----------------
# Frontend URLs
# ----------------
CUSTOMER_WEB_URL=http://localhost:3001
CUSTOMER_APP_URL=exp://localhost:19000
VENDOR_APP_URL=exp://localhost:19001
RIDER_APP_URL=exp://localhost:19002

# Production URLs
# CUSTOMER_WEB_URL=https://asoose.com
# CUSTOMER_APP_URL=https://app.asoose.com
# VENDOR_APP_URL=https://vendor.asoose.com
# RIDER_APP_URL=https://rider.asoose.com

# ----------------
# Payment (Paystack)
# ----------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx

# ----------------
# Payment (Flutterwave)
# ----------------
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxx

# ----------------
# Payment (Monnify)
# ----------------
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=your-api-key
MONNIFY_SECRET_KEY=your-secret-key
MONNIFY_CONTRACT_CODE=your-contract-code

# Production Monnify
# MONNIFY_BASE_URL=https://api.monnify.com

# ----------------
# Backend URL
# ----------------
BACKEND_URL=http://localhost:3000

# ----------------
# Maps API
# ----------------
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ----------------
# NUBAN Account Verification
# ----------------
NUBAN_API_KEY=your-nuban-api-key

# ----------------
# Push Notifications (Free - Firebase Cloud Messaging)
# ----------------
# Get from Firebase Console: Project Settings > Cloud Messaging
FCM_SERVER_KEY=your-firebase-server-key
FCM_PROJECT_ID=your-firebase-project-id

# Optional: For Expo push notifications (if using Expo apps)
EXPO_ACCESS_TOKEN=your-expo-access-token

# ----------------
# Logging
# ----------------
LOG_LEVEL=debug
LOG_FORMAT=json

# ----------------
# Bull Queue (Optional)
# ----------------
QUEUE_HOST=localhost
QUEUE_PORT=6379
QUEUE_PASSWORD=redis_password

# ----------------
# Health Check
# ----------------
HEALTH_CHECK_PATH=/health

# ----------------
# AWS (Production)
# ----------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
