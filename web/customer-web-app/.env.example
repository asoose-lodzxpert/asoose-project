# ============================================
# CUSTOMER WEB APP - ENVIRONMENT VARIABLES
# ============================================

# --------------------------------------------
# Backend API Configuration
# --------------------------------------------
# The URL of your NestJS backend API
# Backend runs on port 3000 with API prefix 'api/v1'
# Development: http://localhost:3000/api/v1
# Production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# --------------------------------------------
# NextAuth Configuration
# --------------------------------------------
# NextAuth secret key - Generate using: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# NextAuth URL - Your app's URL (defaults to localhost in dev)
NEXTAUTH_URL=http://localhost:3001

# --------------------------------------------
# Google OAuth Configuration
# --------------------------------------------
# Get credentials from: https://console.cloud.google.com/
# Create OAuth 2.0 Client ID under Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --------------------------------------------
# Google Maps API
# --------------------------------------------
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Required for: Maps, Geocoding, Places, Directions
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# --------------------------------------------
# Next.js Configuration
# --------------------------------------------
# The public-facing URL of this customer web app.
# MUST be this app's port (3001), NOT the backend port (3000).
# Used to build the callbackUrl sent to the payment gateway so the backend
# knows where to redirect the browser after payment verification.
# Mismatch with BACKEND_URL causes the post-payment redirect to the wrong server.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# App Name
NEXT_PUBLIC_APP_NAME=Asoose Customer Portal

# --------------------------------------------
# Feature Flags (Optional)
# --------------------------------------------
# Enable/disable specific features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# --------------------------------------------
# Firebase / FCM Web Push Notifications
# --------------------------------------------
# Get these from Firebase Console → Project Settings → General → Your apps → Web app
# https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# VAPID key: Firebase Console → Project Settings → Cloud Messaging → Web configuration → Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# --------------------------------------------
# Environment
# --------------------------------------------
NODE_ENV=development
