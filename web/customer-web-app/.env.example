# ============================================
# CUSTOMER WEB APP - ENVIRONMENT VARIABLES
# ============================================

# --------------------------------------------
# Backend API Configuration
# --------------------------------------------
# The URL of your NestJS backend API
# Backend runs on port 3000 with API prefix 'api/v1'
# Development: http://localhost:3000/api/v1
# Production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# --------------------------------------------
# Google Maps API
# --------------------------------------------
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Required for: Maps, Geocoding, Places, Directions
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# --------------------------------------------
# Supabase Configuration (Legacy - Optional)
# --------------------------------------------
# Note: These are legacy Supabase credentials
# Only needed if you're still using Supabase features
# Get these from: https://app.supabase.com/project/_/settings/api

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Public Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --------------------------------------------
# Next.js Configuration
# --------------------------------------------
# Production URL for your customer web app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App Name
NEXT_PUBLIC_APP_NAME=Asoose Customer Portal

# --------------------------------------------
# Feature Flags (Optional)
# --------------------------------------------
# Enable/disable specific features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# --------------------------------------------
# Environment
# --------------------------------------------
NODE_ENV=development
