# ============================================
# CUSTOMER WEB APP - ENVIRONMENT VARIABLES
# ============================================
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PRODUCTION OAUTH CHECKLIST — "Error 400: redirect_uri_mismatch" fix   │
# ├─────────────────────────────────────────────────────────────────────────┤
# │  The exact redirect URI NextAuth sends to Google is:                    │
# │    <NEXTAUTH_URL>/api/auth/callback/google                              │
# │                                                                         │
# │  Every item below MUST be true in production:                           │
# │                                                                         │
# │  [ ] NEXTAUTH_URL=https://www.asoose.com  (HTTPS, no trailing /)       │
# │  [ ] The above URI is added to Google Cloud Console:                    │
# │        APIs & Services → Credentials → OAuth 2.0 Client ID             │
# │        → Authorised redirect URIs                                       │
# │        → https://www.asoose.com/api/auth/callback/google                │
# │  [ ] Authorised JavaScript origins includes:                            │
# │        https://www.asoose.com                                           │
# │  [ ] NEXTAUTH_SECRET is a strong random value (not the placeholder)     │
# │  [ ] GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are the production creds  │
# │  [ ] No .env.local values are leaking into the production container     │
# │                                                                         │
# │  Diagnostic endpoint (shows the exact URI Google receives):             │
# │    curl https://www.asoose.com/api/auth/debug-config \                  │
# │         -H "X-Debug-Token: <NEXTAUTH_SECRET>"                           │
# └─────────────────────────────────────────────────────────────────────────┘

# --------------------------------------------
# Backend API Configuration
# --------------------------------------------
# The URL of your NestJS backend API
# Backend runs on port 3000 with API prefix 'api/v1'
# Development: http://localhost:3000/api/v1
# Production: https://api.asoose.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# INTERNAL_API_URL (optional but recommended in production)
# When set, server-side fetches (e.g. the OAuth signIn callback) use this URL
# instead of NEXT_PUBLIC_API_URL.  In a containerised setup the Next.js
# container can reach the backend on a private network (e.g.
# http://backend:3000/api/v1) while the browser still uses the public URL.
# Leave unset in development — NEXT_PUBLIC_API_URL is used as the fallback.
# INTERNAL_API_URL=http://backend:3000/api/v1

# --------------------------------------------
# NextAuth Configuration
# --------------------------------------------
# NextAuth secret key - Generate using: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# NextAuth URL - MUST be set to the exact public URL of this app in production.
# Omitting or mis-setting this is the #1 cause of "Access Denied" on OAuth.
# It determines the redirect URI sent to Google:
#   <NEXTAUTH_URL>/api/auth/callback/google
# That URI must be listed in the Google Cloud Console's "Authorised redirect URIs".
# Development:  http://localhost:3001
# Production:   https://www.asoose.com  (no trailing slash)
NEXTAUTH_URL=http://localhost:3001

# --------------------------------------------
# Google OAuth Configuration
# --------------------------------------------
# Get credentials from: https://console.cloud.google.com/
# Create OAuth 2.0 Client ID under Credentials
#
# Authorised redirect URIs to add in Google Cloud Console:
#   http://localhost:3001/api/auth/callback/google   (development)
#   https://www.asoose.com/api/auth/callback/google  (production)  ← MUST exist
#
# Missing or wrong redirect URIs result in "Error 400: redirect_uri_mismatch"
# from Google and subsequently "Access Denied" in the app.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --------------------------------------------
# Google Maps API
# --------------------------------------------
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Variable name MUST match exactly: NEXT_PUBLIC_GOOGLE_MAPS_KEY
#
# IMPORTANT — use TWO separate keys in production:
#   1. This frontend key: restrict to HTTP referrers (your domain only)
#      Enabled APIs: Maps JavaScript API
#   2. Backend key (backend/.env GOOGLE_MAPS_API_KEY): restrict to IP addresses
#      Enabled APIs: Geocoding, Places, Directions (used server-side via /maps/* routes)
#
# Using one key for both prevents applying proper restrictions to either.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_frontend_api_key_here

# --------------------------------------------
# Next.js Configuration
# --------------------------------------------
# The public-facing URL of this customer web app.
# MUST be this app's port (3001), NOT the backend port (3000).
# Used to build the callbackUrl sent to the payment gateway so the backend
# knows where to redirect the browser after payment verification.
# Mismatch with BACKEND_URL causes the post-payment redirect to the wrong server.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# App Name
NEXT_PUBLIC_APP_NAME=Asoose Customer Portal

# --------------------------------------------
# Feature Flags (Optional)
# --------------------------------------------
# Enable/disable specific features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# --------------------------------------------
# Firebase / FCM Web Push Notifications
# --------------------------------------------
# Get these from Firebase Console → Project Settings → General → Your apps → Web app
# https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# VAPID key: Firebase Console → Project Settings → Cloud Messaging → Web configuration → Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# --------------------------------------------
# Environment
# --------------------------------------------
NODE_ENV=development
